<header class="site-header" style="--header-bg: {{ section.settings.background_color }}; --header-text: {{ section.settings.text_color }}; --nav-bg: {{ section.settings.nav_background }}; --nav-text: {{ section.settings.nav_text_color }}">
  <div class="header-main-row">
    <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <form class="header-search" action="{{ routes.search_url }}" method="get" role="search" aria-label="Search" data-search-open data-search-form><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"></circle><path d="m16 16 5 5"></path></svg><input type="search" name="q" placeholder="Search..." autocomplete="off" aria-label="Search products" data-search-input><button type="button" class="header-search-clear" aria-label="Clear search" data-search-clear>×</button></form>
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name }} home"><span class="brand-icon" aria-hidden="true"><svg viewBox="0 0 48 40" role="img"><path d="M24 8c0-3 2-5 5-5s5 2 5 5c0 2-1 3-3 4l-7 4L4 27c-2 1-2 4 1 5l16 5c2 1 4 1 6 0l16-5c3-1 3-4 1-5L24 12"/></svg></span><span class="brand-name">{{ section.settings.brand_name }}</span></a>
    <div class="header-actions">
      <a class="header-icon" href="#wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8A4.4 4.4 0 0 1 12 6.7a4.4 4.4 0 0 1 8.8 2.1Z"></path></svg></a>
      <a class="header-icon" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.5" r="3.5"></circle><path d="M4.5 21c.6-4 3-6 7.5-6s6.9 2 7.5 6"></path></svg></a>
      <a class="header-icon cart-icon" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2.1 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.5L20 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="cart-count">{{ cart.item_count }}</span></a>
    </div>
  </div>
  <nav class="main-nav" aria-label="Main navigation">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {% endfor %}
    {% else %}
      {% if section.settings.show_new_arrivals %}<a href="{{ collections['new-arrivals'].url | default: routes.collections_url }}">{{ section.settings.new_arrivals_label }}</a>{% endif %}
      {% if section.settings.show_suit_gowns %}<a href="{{ collections['suit-gowns'].url | default: routes.collections_url }}">{{ section.settings.suit_gowns_label }}</a>{% endif %}
      {% if section.settings.show_best_seller %}<a href="{{ collections['best-sellers'].url | default: routes.collections_url }}">{{ section.settings.best_seller_label }}</a>{% endif %}
      {% if section.settings.show_custom_nav_1 and section.settings.custom_nav_1_label != blank %}<a href="{{ section.settings.custom_nav_1_link | default: routes.collections_url }}">{{ section.settings.custom_nav_1_label }}</a>{% endif %}
      {% if section.settings.show_custom_nav_2 and section.settings.custom_nav_2_label != blank %}<a href="{{ section.settings.custom_nav_2_link | default: routes.collections_url }}">{{ section.settings.custom_nav_2_label }}</a>{% endif %}
      {% if section.settings.show_custom_nav_3 and section.settings.custom_nav_3_label != blank %}<a href="{{ section.settings.custom_nav_3_link | default: routes.collections_url }}">{{ section.settings.custom_nav_3_label }}</a>{% endif %}
      {% if section.settings.show_sale %}<a href="{{ collections.sale.url | default: routes.collections_url }}">{{ section.settings.sale_label }}</a>{% endif %}
    {% endif %}
  </nav>
<div class="search-overlay" id="SearchOverlay" aria-hidden="true">
  <button class="search-overlay-backdrop" type="button" aria-label="Close search" data-search-close></button>
  <section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="SearchHeading">
    <div class="search-panel-heading"><span id="SearchHeading">Search MarkAvenue</span><button class="search-close" type="button" aria-label="Return home" data-search-home>×</button></div>
    {% comment %}The live search input is the header search field above; no duplicate popup input.{% endcomment %}
    {% comment %}
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"></circle><path d="m16 16 5 5"></path></svg>
      <input type="search" name="q" placeholder="Search products" autocomplete="off" aria-label="Search products" data-search-input>
      <button type="button" class="search-input-clear" aria-label="Return home" data-search-home>×</button>
    </form>
    {% endcomment %}
    <div class="search-results" data-search-results aria-live="polite"><p class="search-message">Start typing to search our collection.</p></div>
  </section>
</div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "MarkAvenue" },
    { "type": "color", "id": "background_color", "label": "Header background", "default": "#FBF1E4" },
    { "type": "color", "id": "text_color", "label": "Header text/icon color", "default": "#263A30" },
    { "type": "color", "id": "nav_background", "label": "Navigation background", "default": "#FBF1E4" },
    { "type": "color", "id": "nav_text_color", "label": "Navigation text color", "default": "#263A30" },
    { "type": "checkbox", "id": "show_new_arrivals", "label": "Show New Arrival", "default": true },
    { "type": "text", "id": "new_arrivals_label", "label": "New arrivals label", "default": "NEW ARRIVAL" },
    { "type": "checkbox", "id": "show_suit_gowns", "label": "Show Suit & Gowns", "default": true },
    { "type": "text", "id": "suit_gowns_label", "label": "Suit & gowns label", "default": "SUIT & GOWNS" },
    { "type": "checkbox", "id": "show_best_seller", "label": "Show Best Seller", "default": true },
    { "type": "text", "id": "best_seller_label", "label": "Best seller label", "default": "BEST SELLER" },
    { "type": "checkbox", "id": "show_custom_nav_1", "label": "Show custom item 1", "default": false },
    { "type": "text", "id": "custom_nav_1_label", "label": "Custom item 1 label", "default": "NEW MENU ITEM" },
    { "type": "url", "id": "custom_nav_1_link", "label": "Custom item 1 link" },
    { "type": "checkbox", "id": "show_custom_nav_2", "label": "Show custom item 2", "default": false },
    { "type": "text", "id": "custom_nav_2_label", "label": "Custom item 2 label", "default": "NEW MENU ITEM" },
    { "type": "url", "id": "custom_nav_2_link", "label": "Custom item 2 link" },
    { "type": "checkbox", "id": "show_custom_nav_3", "label": "Show custom item 3", "default": false },
    { "type": "text", "id": "custom_nav_3_label", "label": "Custom item 3 label", "default": "NEW MENU ITEM" },
    { "type": "url", "id": "custom_nav_3_link", "label": "Custom item 3 link" },
    { "type": "checkbox", "id": "show_sale", "label": "Show Sale", "default": true },
    { "type": "text", "id": "sale_label", "label": "Sale label", "default": "SALE" }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation item",
      "settings": [
        { "type": "text", "id": "label", "label": "Menu label", "default": "New Arrival" },
        { "type": "url", "id": "link", "label": "Menu link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Header" }]
}
{% endschema %}

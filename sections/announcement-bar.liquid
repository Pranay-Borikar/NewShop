<div class="announcement-bar" role="status">
  <div class="announcement-track">
    {% for i in (1..6) %}<span>{{ section.settings.message }}</span><b>✦</b>{% endfor %}
  </div>
</div>
{% schema %}
{ "name": "Announcement bar", "settings": [{ "type": "text", "id": "message", "label": "Ticker message", "default": "USE CODE WELCOME20 FOR 20% OFF YOUR ORDER" }] }
{% endschema %}

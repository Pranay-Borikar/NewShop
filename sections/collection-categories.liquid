<section class="collection-categories" style="--collection-categories-bg: {{ section.settings.background_color }}; --collection-categories-text: {{ section.settings.text_color }}; --collection-categories-columns: {{ section.settings.columns }}; --collection-categories-gap: {{ section.settings.grid_gap }}px; --collection-categories-radius: {{ section.settings.image_radius }}px; --collection-categories-padding-top: {{ section.settings.padding_top }}px; --collection-categories-padding-bottom: {{ section.settings.padding_bottom }}px">
  <div class="collection-categories-inner">
    {% if section.settings.show_heading and section.settings.heading != blank %}<header class="collection-categories-heading"><h1>{{ section.settings.heading }}</h1>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}</header>{% endif %}
    <div class="collection-categories-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign category_tag = block.settings.product_tag | default: block.settings.title %}
          {% assign category_handle = category_tag | handleize %}
          {% assign category_url = block.settings.link %}
          {% if category_url == blank %}{% assign category_url = routes.all_products_collection_url | append: '/' | append: category_handle %}{% endif %}
          {% assign category_image = block.settings.image %}
          {% if category_image == blank %}
            {% for category_product in collections.all.products %}
              {% if category_product.tags contains category_tag %}{% assign category_image = category_product.featured_image %}{% break %}{% endif %}
            {% endfor %}
          {% endif %}
          <a class="collection-category-card" href="{{ category_url }}" {{ block.shopify_attributes }}>
            <span class="collection-category-image">{% if category_tag == 'Gown' %}<img src="{{ 'category-gown.jpg' | asset_url }}" alt="Gown" width="2560" height="2560" loading="lazy">{% elsif category_tag == 'Pakistani Suit' %}<img src="{{ 'category-pakistani-suit.jpg' | asset_url }}" alt="Pakistani Suit" width="1280" height="1280" loading="lazy">{% elsif category_image != blank %}{{ category_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', alt: block.settings.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'collection-category-placeholder' }}{% endif %}</span>
            <span class="collection-category-name">{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      {% else %}
        {% for category_tag in collections.all.all_tags limit: section.settings.category_limit %}
          {% assign category_handle = category_tag | handleize %}
          {% assign category_url = routes.all_products_collection_url | append: '/' | append: category_handle %}
          {% assign category_image = blank %}
          {% for category_product in collections.all.products %}
            {% if category_product.tags contains category_tag %}{% assign category_image = category_product.featured_image %}{% break %}{% endif %}
          {% endfor %}
          <a class="collection-category-card" href="{{ category_url }}">
            <span class="collection-category-image">{% if category_tag == 'Gown' %}<img src="{{ 'category-gown.jpg' | asset_url }}" alt="Gown" width="2560" height="2560" loading="lazy">{% elsif category_tag == 'Pakistani Suit' %}<img src="{{ 'category-pakistani-suit.jpg' | asset_url }}" alt="Pakistani Suit" width="1280" height="1280" loading="lazy">{% elsif category_image != blank %}{{ category_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', alt: category_tag }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'collection-category-placeholder' }}{% endif %}</span>
            <span class="collection-category-name">{{ category_tag }}</span>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Find your perfect style" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5E1838" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "default": 20 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "default": 8 },
    { "type": "range", "id": "category_limit", "label": "Number of automatic categories", "min": 3, "max": 12, "step": 1, "default": 9 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 20, "max": 140, "step": 4, "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 20, "max": 140, "step": 4, "default": 72 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category name", "default": "New category" },
        { "type": "text", "id": "product_tag", "label": "Product tag to filter (optional)", "info": "Leave blank to use the category name." },
        { "type": "image_picker", "id": "image", "label": "Category image" },
        { "type": "url", "id": "link", "label": "Category link (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Collection categories" }]
}
{% endschema %}

<div class="festive-announcement" role="status" data-festive-sale data-sale-end="{{ section.settings.sale_end_date }}T23:59:59+05:30">
  <div class="festive-announcement-copy">
    <strong>{{ section.settings.sale_heading }}</strong>
    <span>{{ section.settings.sale_subheading }}</span>
  </div>
  <div class="festive-countdown" aria-label="Festive sale countdown">
    <div><b data-sale-days>00</b><small>DAY</small></div><i>:</i>
    <div><b data-sale-hours>08</b><small>HOUR</small></div><i>:</i>
    <div><b data-sale-minutes>23</b><small>MIN</small></div><i>:</i>
    <div><b data-sale-seconds>25</b><small>SEC</small></div>
  </div>
  <span class="festive-code">✦ {{ section.settings.coupon_text }}</span>
</div>
{% schema %}
{
  "name": "Festive sale announcement",
  "settings": [
    { "type": "text", "id": "sale_heading", "label": "Sale heading", "default": "FESTIVE SALE IS LIVE: UPTO 80% OFF" },
    { "type": "text", "id": "sale_subheading", "label": "Sale subheading", "default": "Applicable only on Prepaid Orders" },
    { "type": "text", "id": "coupon_text", "label": "Coupon button text", "default": "USE - FESTIVE80" },
    { "type": "text", "id": "sale_end_date", "label": "Sale end date (YYYY-MM-DD)", "default": "2026-10-20" }
  ]
}
{% endschema %}

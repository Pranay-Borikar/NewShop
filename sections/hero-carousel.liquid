<section class="hero-carousel" data-carousel data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="carousel-slides">
    {% for i in (1..4) %}
      {% assign image_key = 'slide_' | append: i %}
      {% assign image = section.settings[image_key] %}
      {% case i %}{% when 1 %}{% assign banner_asset = 'banner.png' %}{% when 2 %}{% assign banner_asset = 'banner1.png' %}{% when 3 %}{% assign banner_asset = 'banner2.png' %}{% when 4 %}{% assign banner_asset = 'banner3.png' %}{% endcase %}
      <div class="carousel-slide{% if forloop.first %} is-active{% endif %}">
        <picture><img class="hero-image" src="{{ banner_asset | asset_url }}" alt="{{ section.settings.heading }}" width="2172" height="724"{% if forloop.first %} loading="eager"{% else %} loading="lazy"{% endif %}></picture>
      </div>
    {% endfor %}
  </div>
  <div class="carousel-dots" aria-label="Carousel controls">{% for i in (1..4) %}<button type="button" data-slide="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>{% endfor %}</div>
</section>
{% schema %}
{ "name": "Hero carousel", "settings": [
  { "type": "image_picker", "id": "slide_1", "label": "Slide 1" }, { "type": "image_picker", "id": "slide_2", "label": "Slide 2" }, { "type": "image_picker", "id": "slide_3", "label": "Slide 3" }, { "type": "image_picker", "id": "slide_4", "label": "Slide 4" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for every celebration" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Traditions in timeless elegance" }, { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" }, { "type": "url", "id": "button_link", "label": "Button link" }, { "type": "range", "id": "interval", "label": "Auto-scroll seconds", "min": 3, "max": 12, "step": 1, "default": 5 }
] }
{% endschema %}

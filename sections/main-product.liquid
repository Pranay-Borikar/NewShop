<section class="main-product"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'detail-image' }}{% endif %}</div><div><p class="vendor">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p class="detail-price">{{ product.price | money }}</p><div>{{ product.description }}</div>{% form 'product', product %}<button class="button" type="submit">Add to cart</button>{% endform %}</div></section>
{% schema %}{ "name": "Main product", "settings": [] }{% endschema %}

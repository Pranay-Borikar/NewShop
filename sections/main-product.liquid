<section class="product-detail-page">
  <div class="product-gallery">
    <div class="product-thumbnails" aria-label="Product images">{% for image in product.images %}<button type="button" class="product-thumb{% if forloop.first %} is-selected{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}</button>{% endfor %}</div>
    <div class="product-main-image-wrap"><span class="detail-badge">NEW</span>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'product-main-image', loading: 'eager', alt: product.title, data-gallery-main: '0' }}{% endif %}</div>
  </div>
  <div class="mobile-product-carousel" aria-label="Product image carousel"><div class="mobile-carousel-track">{% for image in product.images %}<div class="mobile-carousel-slide">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}{% if forloop.first %}<span class="detail-badge">NEW</span>{% endif %}</div>{% endfor %}</div><div class="mobile-carousel-dots">{% for image in product.images %}<i{% if forloop.first %} class="is-active"{% endif %}></i>{% endfor %}</div></div>
  <div class="product-details">
    <p class="detail-vendor">MARKAVENUE</p><h1>{{ product.title }}</h1><p class="detail-price">{{ product.price | money }}</p><p class="tax-note">Inclusive of all taxes</p><hr>
    {% form 'product', product, class: 'product-form' %}<div class="size-heading"><span>SIZE</span><a href="#size-guide">Size chart →</a></div><div class="variant-options" role="radiogroup" aria-label="Product sizes">{% for variant in product.variants %}<label class="variant-choice{% if forloop.first %} is-selected{% endif %}"><input type="radio" name="id" value="{{ variant.id }}"{% if forloop.first %} checked{% endif %}><span>{{ variant.title }}</span></label>{% endfor %}</div><p class="trust-line">900K+ Trusted Customers | 1.7M+ Happy Followers</p><div class="buy-row"><button class="wishlist-detail" type="button" aria-label="Add to wishlist">♡</button><button class="add-button" type="submit">ADD TO CART</button></div>{% endform %}
    <div class="shipping-points"><p>▣ &nbsp; Free Shipping On Prepaid &amp; COD*</p><p>◎ &nbsp; Worldwide Shipping</p></div><div class="specifications"><h2>SPECIFICATIONS</h2><div class="spec-grid"><div><span>Category</span><b>{{ product.type | default: 'Women’s Wear' }}</b></div><div><span>Brand</span><b>MarkAvenue</b></div><div><span>Material</span><b>Premium Fabric</b></div><div><span>Occasion</span><b>Everyday &amp; Festive</b></div></div></div><details><summary>DESCRIPTION</summary><div>{{ product.description }}</div></details><details><summary>SHIPPING INFORMATION</summary><div>Free shipping on prepaid orders. Delivery timelines vary by location.</div></details>
  </div>
</section>
{% schema %}{ "name": "Main product", "settings": [] }{% endschema %}

<section class="product-detail-page">
  <div class="product-gallery"><div class="product-thumbnails" aria-label="Product images">{% for image in product.images %}<button type="button" class="product-thumb{% if forloop.first %} is-selected{% endif %}" aria-label="View image {{ forloop.index }}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}</button>{% endfor %}</div><div class="product-main-image-wrap"><span class="detail-badge">NEW</span>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'product-main-image', loading: 'eager', alt: product.title }}{% endif %}</div></div>
  <div class="mobile-product-carousel" aria-label="Product image carousel"><div class="mobile-carousel-track">{% for image in product.images %}<div class="mobile-carousel-slide">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}{% if forloop.first %}<span class="detail-badge">NEW</span>{% endif %}</div>{% endfor %}</div><div class="mobile-carousel-dots">{% for image in product.images %}<i{% if forloop.first %} class="is-active"{% endif %}></i>{% endfor %}</div></div>
  <div class="product-details"><a class="detail-vendor" href="{{ routes.root_url }}" role="link" tabindex="0">AACHHO</a><h1>{{ product.title }}</h1><div class="product-reviews" aria-label="Product rating"><span class="stars">★★★★★</span><a href="#reviews">6 reviews</a></div><div class="price-line"><span class="detail-price">{{ product.price | money_without_trailing_zeros }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% assign saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}<b>{{ saving }}% off</b>{% endif %}</div><p class="tax-note">Inclusive of all taxes</p><hr>
    {% form 'product', product, class: 'product-form' %}<div class="size-heading"><span>SIZE</span><a href="#size-guide">Size chart →</a></div><div class="variant-options" role="radiogroup" aria-label="Product sizes">{% for variant in product.variants %}<label class="variant-choice{% if forloop.first %} is-selected{% endif %}"><input type="radio" name="id" value="{{ variant.id }}"{% if forloop.first %} checked{% endif %}><span>{{ variant.title }} <i aria-hidden="true">ϟ</i></span></label>{% endfor %}</div><p class="trust-line">900K+ Trusted Customers | 1.7M+ Happy Followers</p><div class="buy-row"><button class="wishlist-detail" type="button" aria-label="Add to wishlist">♡</button><button class="add-button" type="submit">ADD TO CART</button></div>{% endform %}
    <div class="shipping-points"><p>▣ &nbsp; Free Shipping On Prepaid &amp; COD*</p><p>◉ &nbsp; Worldwide Shipping</p></div><div class="specifications"><h2>SPECIFICATIONS</h2><div class="spec-grid"><div><span>Category</span><b>{{ product.type | default: 'Women’s Wear' }}</b></div><div><span>Brand</span><b>Aachho</b></div><div><span>Material</span><b>Premium Fabric</b></div><div><span>Occasion</span><b>Everyday &amp; Festive</b></div></div></div><details open><summary role="button" tabindex="0">DESCRIPTION</summary><div>{{ product.description }}</div></details><details><summary role="button" tabindex="0">SHIPPING INFORMATION</summary><div>Free shipping on prepaid orders. Delivery timelines vary by location.</div></details>
  </div>
</section>
{% schema %}{ "name": "Main product", "settings": [] }{% endschema %}

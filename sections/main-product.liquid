<section class="product-detail-page">
  <div class="product-gallery"><div class="product-thumbnails" aria-label="Product images">{% for image in product.images %}<button type="button" class="product-thumb{% if forloop.first %} is-selected{% endif %}" aria-label="View image {{ forloop.index }}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}</button>{% endfor %}</div><div class="product-main-image-wrap"><span class="detail-badge">NEW</span>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'product-main-image', loading: 'eager', alt: product.title }}{% endif %}</div></div>
  <div class="mobile-product-carousel" aria-label="Product image carousel"><div class="mobile-carousel-track">{% for image in product.images %}<div class="mobile-carousel-slide">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}{% if forloop.first %}<span class="detail-badge">NEW</span>{% endif %}</div>{% endfor %}</div><div class="mobile-carousel-dots">{% for image in product.images %}<i{% if forloop.first %} class="is-active"{% endif %}></i>{% endfor %}</div></div>
  <div class="product-details"><a class="detail-vendor" href="{{ routes.root_url }}" role="link" tabindex="0">MarkAvenue</a><h1>{{ product.title }}</h1><div class="product-reviews" aria-label="Product rating"><span class="stars">★★★★★</span><a href="#reviews">6 reviews</a></div><div class="price-line"><span class="detail-price">{{ product.price | money_without_trailing_zeros }}</span>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% assign saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}<b>{{ saving }}% off</b>{% endif %}</div><p class="tax-note">Inclusive of all taxes</p><hr>
    {% if product.tags contains 'RTS' or product.tags contains 'ready_to_ship' or product.tags contains 'ready-to-ship' %}<div class="ready-to-ship" data-ready-deadline="2026-10-20T23:59:59+05:30"><div class="ready-heading"><img class="ready-bolt" src="{{ 'lightning-rts.png' | asset_url }}" alt="" aria-hidden="true"><strong>READY TO SHIP</strong><span class="ready-info" aria-label="Ready to ship information">i</span></div><p>Dispatches within 24 hours</p><div class="ready-countdown"><span class="ready-clock">◷</span><span>Order within <b data-ready-countdown>calculating...</b> to get it by <strong>20 Oct 2026</strong></span></div></div>{% endif %}
    {% form 'product', product, class: 'product-form' %}<div class="size-heading"><span>SIZE</span><a href="#size-guide">Size chart →</a></div><div class="variant-options" role="radiogroup" aria-label="Product sizes">{% for variant in product.variants %}<label class="variant-choice{% if forloop.first %} is-selected{% endif %}"><input type="radio" name="id" value="{{ variant.id }}"{% if forloop.first %} checked{% endif %}><span>{{ variant.title }}{% if product.tags contains 'RTS' or product.tags contains 'ready_to_ship' or product.tags contains 'ready-to-ship' %} <i aria-hidden="true"><img src="{{ 'lightning-rts.png' | asset_url }}" alt=""></i>{% endif %}</span></label>{% endfor %}</div><p class="trust-line">900K+ Trusted Customers | 1.7M+ Happy Followers</p><div class="buy-row"><button class="wishlist-detail" type="button" aria-label="Add to wishlist">♡</button><button class="add-button" type="submit">ADD TO CART</button></div>{% endform %}
    <div class="shipping-points"><p><img src="{{ 'shipping-truck.png' | asset_url }}" alt="" aria-hidden="true"> Free Shipping On Prepaid &amp; COD*</p><p><img src="{{ 'shipping-worldwide.png' | asset_url }}" alt="" aria-hidden="true"> Worldwide Shipping</p></div><div class="specifications"><h2>SPECIFICATIONS</h2><div class="spec-grid"><div><span>Category</span><b>{{ product.type | default: 'Women’s Wear' }}</b></div><div><span>Brand</span><b>MarkAvenue</b></div><div><span>Material</span><b>Premium Fabric</b></div><div><span>Occasion</span><b>Everyday &amp; Festive</b></div></div></div><details><summary role="button" tabindex="0">DESCRIPTION</summary><div>{{ product.description }}</div></details><details><summary role="button" tabindex="0">SHIPPING INFORMATION</summary><div>Free shipping on prepaid orders. Delivery timelines vary by location.</div></details>
  </div>
</section>
<style>
  .product-detail-page{padding-left:2%;padding-right:2%}
  .variant-choice span{min-width:58px;padding:9px 13px;font-size:16px}
  .ready-to-ship{margin:0 0 26px;padding:16px 20px;background:#fff0f1;border-radius:12px;color:#404040;font-family:'Outfit',sans-serif}
  .ready-heading{display:flex;align-items:center;gap:14px;font-size:16px}.ready-bolt{color:#ed3d43;font-size:30px;font-weight:700;line-height:1}.ready-info{display:grid;place-items:center;width:20px;height:20px;border:2px solid #404040;border-radius:50%;font-weight:700;font-size:13px;margin-left:4px}.ready-to-ship p{margin:6px 0 14px;color:#555}.ready-countdown{display:flex;gap:12px;align-items:center;border:1px dashed #ed8e96;border-radius:8px;padding:11px 14px;color:#404040;font-size:14px}.ready-clock{color:#ed3d43;font-size:23px}.ready-countdown b{color:#d46d6e}.ready-countdown strong{color:#168254}
  @media(max-width:749px){.product-detail-page{padding-left:12px;padding-right:12px}.variant-choice span{min-width:54px;padding:9px 11px;font-size:15px}.ready-to-ship{padding:14px;margin-bottom:20px}.ready-countdown{font-size:13px}}
</style>
{% schema %}{ "name": "Main product", "settings": [] }{% endschema %}

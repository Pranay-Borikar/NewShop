<section class="related-products" style="--related-columns: {{ section.settings.columns }}; --related-gap: {{ section.settings.grid_gap }}px"><div class="related-heading"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div class="product-grid related-product-grid">{% assign related_collection = collections.all %}{% assign related_limit = section.settings.columns | times: section.settings.rows %}{% for related_product in related_collection.products limit: related_limit %}{% unless related_product.id == product.id %}{% render 'product-card', product: related_product %}{% endunless %}{% endfor %}</div></section>
{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPLETE THE LOOK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "columns", "label": "Grid columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "rows", "label": "Grid rows", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap (px)", "min": 0, "max": 40, "step": 2, "default": 12 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}

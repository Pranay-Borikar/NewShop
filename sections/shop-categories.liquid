<section class="shop-categories" aria-label="{{ section.settings.heading }}">
  {% if section.settings.heading != blank %}<h2 class="shop-categories-heading">{{ section.settings.heading }}</h2>{% endif %}
  <div class="shop-categories-track">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a class="shop-category" href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}
          <span>{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    {% else %}
      <a class="shop-category" href="{{ collections['anarkali-sets'].url | default: routes.collections_url }}"><img src="https://cdn.shopify.com/s/files/1/2542/7564/files/1_911773c9-dc70-4a34-8bcd-53b6a7509ecf.jpg?v=1791445550" alt="Anarkali Sets" loading="lazy"><span>Anarkali Sets</span></a>
      <a class="shop-category" href="{{ collections['suit-sets'].url | default: routes.collections_url }}"><img src="https://cdn.shopify.com/s/files/1/2542/7564/files/1_782d6499-ca71-481c-82d5-374112ebbc06.jpg?v=1791445605" alt="Suit Sets" loading="lazy"><span>Suit Sets</span></a>
      <a class="shop-category" href="{{ collections.maxis.url | default: routes.collections_url }}"><img src="{{ 'product1.webp' | asset_url }}" alt="Maxis" loading="lazy"><span>Maxis</span></a>
      <a class="shop-category" href="{{ collections.dresses.url | default: routes.collections_url }}"><img src="{{ 'product2.webp' | asset_url }}" alt="Dresses" loading="lazy"><span>Dresses</span></a>
      <a class="shop-category" href="{{ collections.sarees.url | default: routes.collections_url }}"><img src="https://cdn.shopify.com/s/files/1/2542/7564/files/2_29500818-5979-46e9-9cb9-38df403e7725.jpg?v=1791445723" alt="Sarees" loading="lazy"><span>Sarees</span></a>
      <a class="shop-category" href="{{ collections.lehengas.url | default: routes.collections_url }}"><img src="https://cdn.shopify.com/s/files/1/2542/7564/files/2_b6f189ad-8242-468d-8d66-503ae7ba794d.jpg?v=1791445415" alt="Lehengas" loading="lazy"><span>Lehengas</span></a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Shop categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category name", "default": "New category" },
        { "type": "image_picker", "id": "image", "label": "Category image" },
        { "type": "url", "id": "link", "label": "Category link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Shop categories" }]
}
{% endschema %}

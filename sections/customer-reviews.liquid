<section class="customer-reviews" data-customer-reviews style="--reviews-bg: {{ section.settings.background_color }}; --reviews-text: {{ section.settings.text_color }}; --reviews-accent: {{ section.settings.accent_color }}">
  <div class="customer-reviews-panel">
    <h2>{{ section.settings.heading }}</h2>
    <div class="customer-reviews-summary">
      <div class="customer-reviews-summary-copy">
        <div class="customer-reviews-stars" aria-label="{{ section.settings.rating }} out of 5 stars">☆☆☆☆☆</div>
        <p>{{ section.settings.empty_message }}</p>
      </div>
      <button class="customer-reviews-button" type="button" data-review-trigger aria-expanded="false">{{ section.settings.button_label }}</button>
    </div>
  </div>

  <div class="customer-reviews-divider"></div>
  <h3 class="customer-reviews-subheading">{{ section.settings.reviews_heading }}</h3>
  <div class="customer-review-placeholders" aria-label="Example customer reviews">
    <article class="customer-review-placeholder"><div class="placeholder-stars">★★★★★</div><h4>{{ section.settings.review_one_title }}</h4><p>{{ section.settings.review_one_text }}</p><small>{{ section.settings.verified_text }}</small></article>
    <article class="customer-review-placeholder"><div class="placeholder-stars">★★★★★</div><h4>{{ section.settings.review_two_title }}</h4><p>{{ section.settings.review_two_text }}</p><small>{{ section.settings.verified_text }}</small></article>
  </div>
  <p class="customer-reviews-note">{{ section.settings.placeholder_note }}</p>

  <div class="customer-reviews-widget" data-review-form>
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-auto-install="true" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</section>
<script>
  (() => {
    const section = document.querySelector('[data-customer-reviews]');
    if (!section || section.dataset.bound) return;
    section.dataset.bound = 'true';
    const trigger = section.querySelector('[data-review-trigger]');
    const form = section.querySelector('[data-review-form]');
    trigger?.addEventListener('click', () => {
      const open = section.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) window.setTimeout(() => form.scrollIntoView({ behavior: 'smooth', block: 'start' }), 120);
    });
  })();
</script>
{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "0" },
    { "type": "text", "id": "empty_message", "label": "Empty review message", "default": "Be the first to write a review" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Write a review" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews list heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "review_one_title", "label": "Placeholder review 1 title", "default": "Beautiful outfit!" },
    { "type": "text", "id": "review_one_text", "label": "Placeholder review 1 text", "default": "Customer review will appear here." },
    { "type": "text", "id": "review_two_title", "label": "Placeholder review 2 title", "default": "Loved the quality!" },
    { "type": "text", "id": "review_two_text", "label": "Placeholder review 2 text", "default": "Another customer review will appear here." },
    { "type": "text", "id": "verified_text", "label": "Verified text", "default": "Verified buyer, when verified" },
    { "type": "text", "id": "placeholder_note", "label": "Placeholder note", "default": "Design preview only — these are example placeholders, not real customer reviews." },
    { "type": "color", "id": "background_color", "label": "Panel background", "default": "#FFF5F6" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FBF1E4" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#B8553F" }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}

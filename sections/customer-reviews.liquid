<section class="customer-reviews" style="--reviews-bg: {{ section.settings.background_color }}; --reviews-text: {{ section.settings.text_color }}; --reviews-accent: {{ section.settings.accent_color }}">
  <h2>{{ section.settings.heading }}</h2>
  <div class="customer-reviews-widget">
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "0" },
    { "type": "text", "id": "empty_message", "label": "Empty review message", "default": "Be the first to write a review" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Write a review" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFF5F6" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#242024" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#B8553F" }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}

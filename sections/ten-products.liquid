<section class="product-section" id="lookbook">
  <div class="section-banner"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><span>{{ section.settings.subheading }}</span></div>
  <div class="product-grid">
    {% assign products_to_show = collections.all.products %}
    {% for product in products_to_show limit: 10 %}
      {% render 'product-card', product: product %}
    {% else %}
      {% for i in (1..10) %}<article class="product-card placeholder-card"><div class="placeholder-image"><span>{{ i }}</span></div><h3>Featured product {{ i }}</h3><p>Set up products in Shopify to populate this grid.</p></article>{% endfor %}
    {% endfor %}
  </div>
</section>
{% schema %}
{ "name": "10 product grid", "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated collection" }, { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" }, { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover pieces designed for everyday celebrations." } ] }
{% endschema %}

<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer-backdrop" data-cart-close></div>
  <div class="cart-drawer-panel">
    <header class="cart-drawer-header"><strong>Login to unlock exclusive offers</strong><a href="{{ routes.account_login_url }}" aria-label="Login">›</a><button type="button" data-cart-close aria-label="Close cart">×</button></header>
    <div class="cart-drawer-scroll">
      <div class="cart-sale-banner">Flash Sale: Flat 50% Off (LAST DAY GRAB FAST)</div>
      <div class="cart-items" data-cart-items></div>
      <section class="coupon-box"><div class="coupon-summary"><span>✿ &nbsp; <b data-coupon-code>PRE5</b></span><small data-coupon-saving></small><button type="button" data-coupon-apply>Apply</button></div><button class="coupon-toggle" type="button" data-coupon-toggle>Enter coupon code <span>⌄</span></button><div class="coupon-entry" data-coupon-entry><input type="text" placeholder="Enter coupon code" data-coupon-input><button type="button" data-coupon-submit>Apply</button><p data-coupon-message></p></div><button class="offers-row" type="button">🎁 <span><b>View all offers</b><small>Coupons · Payment Offers · EMI</small></span><i>29</i><strong>›</strong></button></section>
      <section class="drawer-upsell"><h2>Cart Upsell</h2><div class="upsell-track">{% assign upsell_collection = collections.all %}{% for upsell in upsell_collection.products limit: 10 %}<article class="upsell-product" data-upsell-handle="{{ upsell.handle }}"><a href="{{ upsell.url }}">{% if upsell.featured_image %}{{ upsell.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: upsell.title }}{% endif %}</a><div><a href="{{ upsell.url }}">{{ upsell.title | truncate: 28 }}</a><b>{{ upsell.price | money }}</b><button type="button" data-upsell-add data-variant-id="{{ upsell.selected_or_first_available_variant.id }}">+ Add</button></div></article>{% endfor %}</div></section>
    </div>
    <footer class="cart-total"><div class="total-heading"><strong>▣ &nbsp; Estimated Total</strong><span data-cart-total>₹0</span></div><div class="total-benefits"><span>🚚 FREE shipping included</span><span>✓ Save up to ₹300.00 on Prepaid</span></div><a class="checkout-button" href="/checkout" data-checkout>CHECKOUT</a><small>900K+ Trusted Customers | 1.1 Million+ Happy Followers</small><em>Powered by <b>GoKwik</b></em></footer>
  </div>
</aside>

<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer-backdrop" data-cart-close></div>
  <div class="cart-drawer-panel">
    <header class="cart-drawer-header"><span class="drawer-account-icon"></span><strong></strong><a href="{{ routes.account_login_url }}" aria-label="Login"></a><button type="button" data-cart-close aria-label="Close cart">×</button></header>
    <div class="cart-drawer-scroll"><div class="cart-sale-banner">Flash Sale: Flat 50% Off (LAST DAY GRAB FAST)</div><div class="cart-items" data-cart-items></div>
      <section class="coupon-box"><div class="coupon-summary"><span class="coupon-icon">⌑</span><b data-coupon-code>PRE5</b><small data-coupon-saving>Extra 5% off · save ₹300.00</small><button type="button" data-coupon-apply>Apply</button></div><button class="coupon-toggle" type="button" data-coupon-toggle>Enter coupon code <span>⌄</span></button><div class="coupon-entry" data-coupon-entry><input type="text" placeholder="Enter coupon code" data-coupon-input><button type="button" data-coupon-submit disabled>Apply</button><p data-coupon-message></p></div></section>
      <section class="drawer-upsell"><h2>Cart Upsell</h2><div class="upsell-track">{% assign upsell_collection = collections.all %}{% for upsell in upsell_collection.products limit: 10 %}<article class="upsell-product" data-upsell-handle="{{ upsell.handle }}"><a href="{{ upsell.url }}">{% if upsell.featured_image %}{{ upsell.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: upsell.title }}{% endif %}</a><div><a href="{{ upsell.url }}">{{ upsell.title | truncate: 28 }}</a>{% if upsell.compare_at_price > upsell.price %}<small class="upsell-discount">{{ upsell.compare_at_price | minus: upsell.price | times: 100 | divided_by: upsell.compare_at_price }}% off</small>{% endif %}<b>{{ upsell.price | money }}</b><button type="button" data-upsell-add data-product-title="{{ upsell.title | escape }}" data-product-image="{% if upsell.featured_image %}{{ upsell.featured_image | image_url: width: 180 }}{% endif %}" data-product-price="{{ upsell.price | money }}" data-product-compare="{% if upsell.compare_at_price > upsell.price %}{{ upsell.compare_at_price | money }}{% endif %}">+ Add</button></div><div class="upsell-variants" hidden>{% for variant in upsell.variants %}<button type="button" data-variant-id="{{ variant.id }}" data-variant-title="{{ variant.title }}" data-available="{{ variant.available }}" data-max-quantity="{% if variant.inventory_management and variant.inventory_policy == 'deny' %}{{ variant.inventory_quantity | default: 1 }}{% else %}99{% endif %}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}</button>{% endfor %}</div></article>{% endfor %}</div></section>
    </div>
    <footer class="cart-total"><div class="total-heading"><strong><img class="estimated-total-icon" src="https://cdn.vectorstock.com/i/500p/39/74/indian-rupee-wallet-icon-vector-65573974.jpg" alt=""> Estimated Total <span class="total-chevron"></span></strong><span data-cart-total>₹0</span></div><div class="total-benefits"><span>🚚 FREE shipping included</span><span></span></div><a class="checkout-button" href="/checkout" data-checkout>CHECKOUT</a><small>900K+ Trusted Customers | 1.1 Million+ Happy Followers</small><em><b></b></em></footer>
    <div class="variant-modal" data-variant-modal aria-hidden="true"><div class="variant-modal-box"><header class="variant-modal-header"><h2>Select Variant</h2><button type="button" class="variant-modal-close" data-variant-close aria-label="Close variant selector">×</button></header><div data-variant-modal-content></div></div></div>
  </div>
</aside>

<article class="product-card" data-wishlist-handle="{{ product.handle }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-url="{{ product.url }}">
  {% assign default_sizes = 'S,M,L,XL,XXL' | split: ',' %}
  {% assign is_ready_to_ship = false %}{% if product.tags contains 'RTS' or product.tags contains 'ready_to_ship' or product.tags contains 'ready-to-ship' %}{% assign is_ready_to_ship = true %}{% endif %}
  <a href="{{ product.url }}" class="product-image-wrap">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', class: 'product-image', alt: product.title }}
      {% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', class: 'product-image product-image-hover', alt: product.title }}{% endif %}
    {% else %}<div class="placeholder-image"></div>{% endif %}
    {% unless hide_badge %}{% if product.available == false %}<span class="badge">Sold out</span>{% else %}<span class="badge">{{ badge_label | default: 'New' }}</span>{% endif %}{% endunless %}
    <button class="wishlist" type="button" aria-label="Add {{ product.title }} to wishlist" onclick="event.preventDefault()">♡</button>
  </a>
  <a class="product-card-details" href="{{ product.url }}"><div class="product-info"><p class="vendor">BombaySutra</p><h3>{{ product.title }}</h3><p class="price">{% if product.compare_at_price > product.price %}<s class="compare-price">{{ product.compare_at_price | money }}</s> <span class="sale-price">{{ product.price | money }}</span>{% else %}{{ product.price | money }}{% endif %}</p>{% if is_ready_to_ship %}<div class="card-ready-badge"><span>READY TO SHIP</span><b><img src="{{ 'lightning-rts.png' | asset_url }}" alt="" aria-hidden="true"></b></div>{% endif %}<div class="card-size-list" aria-label="Available sizes">{% if product.options_by_name['Size'] %}{% for size in product.options_by_name['Size'].values %}<span class="size-chip">{{ size }}{% if is_ready_to_ship %} <i aria-hidden="true"><img src="{{ 'lightning-rts.png' | asset_url }}" alt=""></i>{% endif %}</span>{% endfor %}{% else %}{% for size in default_sizes %}<span class="size-chip">{{ size }}{% if is_ready_to_ship %} <i aria-hidden="true"><img src="{{ 'lightning-rts.png' | asset_url }}" alt=""></i>{% endif %}</span>{% endfor %}{% endif %}</div></div></a>
</article>

<article class="product-card">
  <a href="{{ product.url }}" class="product-image-wrap">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', class: 'product-image', alt: product.title }}
      {% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', class: 'product-image product-image-hover', alt: product.title }}{% endif %}
    {% else %}<div class="placeholder-image"></div>{% endif %}
    {% if product.available == false %}<span class="badge">Sold out</span>{% else %}<span class="badge">New</span>{% endif %}
    <button class="wishlist" type="button" aria-label="Add {{ product.title }} to wishlist" onclick="event.preventDefault()">♡</button>
    <div class="card-size-list" aria-label="Available sizes">
      {% if product.options_by_name['Size'] %}{% for size in product.options_by_name['Size'].values %}<span class="size-chip">{{ size }}</span>{% endfor %}{% else %}{% for size in 'S,M,L,XL,XXL' | split: ',' %}<span class="size-chip">{{ size }}</span>{% endfor %}{% endif %}
    </div>
  </a>
  <div class="product-info"><p class="vendor">MarkAvenue</p><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p class="price">{{ product.price | money }}</p></div>
</article>

<article class="product-card">
  <a href="{{ product.url }}" class="product-image-wrap">
    {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', class: 'product-image', alt: product.title }}{% else %}<div class="placeholder-image"></div>{% endif %}
    {% if product.available == false %}<span class="badge">Sold out</span>{% else %}<span class="badge">New</span>{% endif %}
  </a>
  <div class="product-info"><p class="vendor">{{ product.vendor }}</p><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p class="price">{{ product.price | money }}</p></div>
</article>
